<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatBot</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            padding-top: 50px;
        }
        #chat-container {
            width: 80%;
            margin: auto;
            max-width: 600px;
        }
        .message {
            padding: 10px;
            margin: 5px;
            border-radius: 5px;
            font-size: 14px;
        }
        .user {
            background-color: #d1e7fd;
            text-align: right;
        }
        .bot {
            background-color: #d4edda;
            text-align: left;
        }
        .chat-header {
            font-size: 24px;
            margin-bottom: 20px;
        }
        #user-input {
            margin-top: 10px;
        }
    </style>
</head>
<body>

    <div class="container text-center">
        <h2 class="chat-header">Bem-vindo ao Chat Test!</h2>
        <div id="chat-container">
            <div id="chat-box" class="mb-3" style="min-height: 200px; overflow-y: scroll;"></div>
            <input type="text" id="user-input" class="form-control" placeholder="Digite sua mensagem..." />
            <button class="btn btn-success mt-3" onclick="sendMessage()">Enviar</button>
        </div>
    </div>

    <script>
        function sendMessage() {
            let userMessage = $("#user-input").val();
            if (!userMessage) return;
            $("#chat-box").append(`<div class="message user"><strong>Você:</strong> ${userMessage}</div>`);
            $("#user-input").val('');
            $.ajax({
                url: "/chat",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ message: userMessage }),
                success: function(response) {
                    $("#chat-box").append(`<div class="message bot"><strong>Bot:</strong> ${response.message}</div>`);
                    $("#chat-box").scrollTop($("#chat-box")[0].scrollHeight); // Rola para a última mensagem
                },
                error: function() {
                    $("#chat-box").append(`<div class="message bot"><strong>Bot:</strong> Erro ao conectar.</div>`);
                    $("#chat-box").scrollTop($("#chat-box")[0].scrollHeight); // Rola para a última mensagem
                }
            });
        }
    </script>

</body>
</html>
